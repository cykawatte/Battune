"mode.7" = "Native Ladegrenze aktiv";
"confirmed_limit" = "macOS-Ladegrenze";
"native_control_detail" = "Battune setzt die native macOS-Ladegrenze und lässt den Netzteileingang eingeschaltet. macOS regelt Ladepausen, Nachladen und Temperaturschutz. Battune erhält die Grenze im Standby; macOS kann zur Messwertkalibrierung gelegentlich bis 100 % laden. Beim Deaktivieren oder Beenden wird die vorherige Grenze wiederhergestellt.";
"native_short_detail" = "Netzteileingang bleibt aktiv · macOS regelt das Laden, auch im Standby. Gelegentliche Apple-Kalibrierung möglich.";
"native_no_helper" = "Die native Ladegrenze wird über den macOS-Ladedienst gesetzt. Kein eigener privilegierter Helper und keine Administratorfreigabe erforderlich.";

"setup" = "Einrichtung";
"setup_native" = "Native Ladegrenze";
"setup_native_detail" = "Für unterstützte Grenzen wie 80 % nutzt Battune automatisch die macOS-Regelung, auch wenn der erweiterte Modus freigeschaltet ist. Der Netzteileingang bleibt aktiv und die Grenze wird vor Standby nicht aufgehoben. Apple kann sie gelegentlich zur Messwertkalibrierung überschreiten.";
"setup_advanced" = "Erweiterte Hardwaresteuerung";
"setup_advanced_detail" = "Der Helper schaltet Entladeziel, Kalibrierung und zusätzliche Grenzen frei. Unterstützte macOS-Grenzen verwenden weiterhin den Netzbetrieb. Nur für Entladen, Kalibrierung oder andere Grenzen schaltet Battune den Netzteileingang über CHIE. Diese zusätzlichen Grenzen nutzen Batterie während Ladepausen und benötigen einen geöffneten Deckel. Im Standby gilt nur die nächsthöhere unterstützte native Grenze, sofern verfügbar.";
"setup_restrictions" = "Die Administratorfreigabe erlaubt den Root-Helper. Apple kann einzelne SMC-Zugriffe trotzdem sperren; private Apple-Berechtigungen lassen sich nicht per Dialog erteilen. Erst ein erfolgreicher Schalttest schaltet die Funktionen frei.";
"install_helper" = "Helper installieren …";
"open_installer" = "Installation öffnen";
"install_consent" = "Der Helper läuft mit Administratorrechten und darf ausschließlich den Netzteileingang schalten und wiederherstellen. macOS fragt bei der Installation nach deiner Zustimmung. Der lokale Build bindet App und Helper an ihre exakten Codesignaturen; nach einem Neubau ist eine erneute Installation nötig.";
"installer_missing" = "Das passende BattuneHelper.pkg muss neben Battune.app liegen. Erzeuge es nach dem App-Build mit scripts/build-helper-installer.sh.";
"helper_setup_missing" = "Helper noch nicht installiert, nicht erreichbar oder Signatur passt nicht zu diesem Build.";
"test_adapter" = "Hardwarezugriff prüfen …";
"adapter_test_consent" = "Dieser Test schaltet den Netzteileingang kurz aus und direkt wieder ein und liest beide Zustände zurück. Mac aufklappen und Netzteil anschließen; mindestens 30 % Ladung und unter 40 °C sind erforderlich. Nach Schlafmodus, Helper-Neustart oder einer Sicherheitsunterbrechung ist der Test erneut nötig.";
"approve_test" = "Schalttest erlauben";
